NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# JSON data store, relative to the backend workspace root. Seeded on first run.
DATA_FILE=data/oaa-data.json

# Optional. GitHub's public API allows 60 unauthenticated requests an hour per IP;
# a personal access token with NO scopes raises that. Sync works without it.
# GITHUB_TOKEN=

# Unused — this project runs on the JSON store above, not Postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/oaa
