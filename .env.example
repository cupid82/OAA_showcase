# Copy to .env and fill in real values. Never commit .env.
# Workspace-specific values live in frontend/.env and backend/.env.

NODE_ENV=development

# --- Backend ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=postgresql://user:password@localhost:5432/oaa
# JWT_SECRET=change-me-to-a-long-random-string

# --- Frontend (must be prefixed with VITE_ to be exposed to the browser) ---
VITE_API_URL=http://localhost:4000
